VOXCANVAS_LLM_PROVIDER=openai
OPENAI_API_KEY=
VOXCANVAS_LLM_MODEL=gpt-5.4-mini

# Optional: use Alibaba Cloud Model Studio / DashScope for semantic planning.
# Set VOXCANVAS_LLM_PROVIDER=dashscope, then configure:
DASHSCOPE_API_KEY=
# VOXCANVAS_LLM_MODEL=qwen3.6-flash
# VOXCANVAS_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: enable real DashScope / Tongyi Wanxiang image generation and editing.
# This uses DASHSCOPE_API_KEY above and keeps the key inside the local Vite proxy.
# Official Wan 2.7 image model names include wan2.7-image-pro and wan2.7-image.
# wan2.7-videoedit is not the still-image API model used by this app path.
VOXCANVAS_IMAGE_MODEL=wan2.7-image-pro
VOXCANVAS_IMAGE_SIZE=2K
# VOXCANVAS_IMAGE_WATERMARK=false
# VOXCANVAS_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
